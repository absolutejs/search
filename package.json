{
  "name": "@absolutejs/search",
  "version": "0.1.0",
  "type": "module",
  "description": "Provider-neutral web search, grounded evidence, and replaceable search adapters",
  "license": "BSL-1.1",
  "author": "Alex Kahn",
  "repository": {
    "type": "git",
    "url": "https://github.com/absolutejs/search.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "changelog.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./brave": {
      "types": "./dist/brave.d.ts",
      "default": "./dist/brave.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "scripts": {
    "build": "bun build src/index.ts src/brave.ts src/manifest.ts --outdir dist --target bun --external @sinclair/typebox && tsc --emitDeclarationOnly && absolute-manifest emit",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check:package": "absolute-changelog check",
    "prepublishOnly": "bun run check:package"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "typescript": "5.9.3",
    "@absolutejs/changelog": "^0.6.0"
  },
  "dependencies": {
    "@absolutejs/manifest": "^0.9.0",
    "@sinclair/typebox": "^0.34.0"
  },
  "absolutejs": {
    "manifestContract": 2
  }
}
